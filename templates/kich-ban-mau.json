    {
      "id": "c03",
      "phan": "boi-canh",
      "loi": "Economists Hersh Shefrin and Meir Statman described it in 1985. Investors tend to sell winners too early, and ride losers too long.",
      "loi_doc": "Economists Hersh Shefrin and Meir Statman described it in nineteen eighty-five. Investors tend to sell winners too early, and ride losers too long.",
      "nen": "#FFFFFF",
      "may_quay": "lia-phai",
      "chuyen_canh": {"kieu": "truot-trai", "thoi_luong": 0.4},
      "lop": [
